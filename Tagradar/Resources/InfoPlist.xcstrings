{
  "sourceLanguage" : "en",
  "strings" : {
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Permission alert shown when the user first taps the map's location button or allows location for the \"Near you\" departures.",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tågradar använder din plats för att centrera kartan och visa tåg nära dig."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Permission alert shown the first time voice search is used.",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofonen används för att söka efter tåg och stationer med rösten."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Permission alert shown the first time voice search is used.",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taligenkänning används för att söka efter tåg och stationer med rösten."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
