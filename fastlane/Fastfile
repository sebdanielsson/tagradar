# Release automation. TestFlight uploads are done by xcodebuild directly (ExportOptions.plist has
# destination=upload); fastlane is only needed for App Store submissions, where deliver uploads the
# binary, the metadata in fastlane/metadata and the screenshots in fastlane/screenshots, then submits
# the version for review.
default_platform(:ios)

platform :ios do
  desc "Upload an .ipa plus metadata and screenshots to App Store Connect and submit for review"
  desc "  fastlane release ipa:path/to/Tagradar.ipa version:1.2.0"
  lane :release do |options|
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_KEY_BASE64"),
      is_key_content_base64: true,
      in_house: false
    )

    upload_to_app_store(
      api_key: api_key,
      ipa: options.fetch(:ipa),
      app_version: options.fetch(:version),
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
      overwrite_screenshots: true,
      # No HTML preview prompt in CI.
      force: true,
      # Precheck needs an Apple ID session, which CI does not have.
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      submit_for_review: true,
      # Go live as soon as Apple approves. A version left in "Pending Developer Release" blocks
      # App Store Connect from creating the next one, which fails the following release run.
      automatic_release: true,
      phased_release: false,
      reject_if_possible: true,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        # The app displays Trafikverket's train data, which is CC0 but still theirs; see
        # docs/app-store.md. Must match the Content Rights answer in App Store Connect.
        content_rights_contains_third_party_content: true
      }
    )
  end
end
