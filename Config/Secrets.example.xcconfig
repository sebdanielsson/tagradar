// Copy this file to Config/Secrets.xcconfig (git-ignored) and fill in your key,
// or run Scripts/bootstrap.sh which generates it from .env.local.
// Register a free key at https://data.trafikverket.se
TRV_API_KEY =
// Your Apple Developer team ID (a free Personal Team works for installing on your own devices).
DEVELOPMENT_TEAM =
// Optional: bundle identifier prefix for builds under your own Apple team.
APP_BUNDLE_ID = se.tagradar.app
// Optional: the Live Activity push server (docs/live-activity-push.md). Host only, without https://
// (xcconfig treats "//" as a comment). Leave empty to update activities only while the app runs.
PUSH_SERVER_HOST =
PUSH_SERVER_SECRET =
// Only for a free Personal Team, which cannot sign the push entitlement (PERSONAL_TEAM=YES in .env.local).
// TAGRADAR_APP_ENTITLEMENTS = Tagradar/TagradarPersonalTeam.entitlements
